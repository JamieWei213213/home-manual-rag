# Copy to .env (git-ignored) or set these in the shell that starts the app.
# Nothing here is read automatically unless you export it; the app never reads
# a key from the UI, never writes one to the project, and never logs one.

# Off by default: manual search works without any of this.
# HOME_MANUAL_ENABLE_GENERATION=1

# Your own DeepSeek API key. Leave blank in this file; set the real value in
# your shell. Never commit a real key.
# DEEPSEEK_API_KEY=

# Optional overrides (defaults shown).
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# In-process guards around the paid endpoint. These bound what this process
# sends; they are not a durable billing cap and reset when the app restarts.
# HOME_MANUAL_GENERATION_MAX_REQUESTS=60
# HOME_MANUAL_GENERATION_MAX_CONCURRENCY=2
# HOME_MANUAL_GENERATION_MAX_CONTEXT_CHARS=12000

# Where the local "My home" SQLite file lives (default: data/household.db).
# HOME_MANUAL_HOUSEHOLD_DB=data/household.db
